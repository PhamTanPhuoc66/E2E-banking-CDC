message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c09ba2-3202-20f8-0011-44ea000438ca"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.dbt_snowflake_trans.fact_transactions", "compiled": true, "compiled_code": "\n\nWITH transactions AS (\n    SELECT * FROM E2E_DB.RAW.stg_transactions\n    \n    -- LOGIC INCREMENTAL:\n    -- Ch\u1ec9 l\u1ea5y c\u00e1c giao d\u1ecbch c\u00f3 th\u1eddi gian x\u1eed l\u00fd (processed_at) L\u1edaN H\u01a0N \n    -- th\u1eddi gian max hi\u1ec7n c\u00f3 trong b\u1ea3ng \u0111\u00edch (this).\n    \n),\n\n-- Join th\u00eam th\u00f4ng tin Account \u0111\u1ec3 l\u1ea5y Customer ID (Denormalization)\naccounts AS (\n    SELECT account_id, customer_id FROM E2E_DB.RAW.stg_accounts\n)\n\nSELECT\n    t.transaction_id,\n    t.account_id,\n    a.customer_id, \n    \n    t.txn_type,\n    t.status,\n    t.amount,\n    \n    -- T\u00e1ch Date Dimension (Ng\u00e0y/Th\u00e1ng/N\u0103m) ph\u1ee5c v\u1ee5 Partitioning ho\u1eb7c Filter nhanh\n    DATE(t.created_at) AS transaction_date_key,\n    YEAR(t.created_at) AS transaction_year,\n    MONTH(t.created_at) AS transaction_month,\n    \n    t.created_at AS transaction_timestamp,\n    t.processed_at, -- C\u1ed9t m\u1ed1c \u0111\u1ec3 ch\u1ea1y incremental\n    current_timestamp() AS dwh_load_at\n\nFROM transactions t\nLEFT JOIN accounts a ON t.account_id = a.account_id", "relation_name": "E2E_DB.RAW_ANALYTICS.fact_transactions", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-24T15:30:36.937269Z", "completed_at": "2025-11-24T15:30:36.938983Z"}, {"name": "execute", "started_at": "2025-11-24T15:30:36.939602Z", "completed_at": "2025-11-24T15:30:38.857967Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.9230520725250244, "adapter_response": {"_message": "SUCCESS 0", "code": "SUCCESS", "rows_affected": 0, "query_id": "01c09ba2-3202-20f8-0011-44ea00043916"}, "message": "SUCCESS 0", "failures": null, "unique_id":