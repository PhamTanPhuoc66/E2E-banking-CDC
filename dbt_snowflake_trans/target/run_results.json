h_load_at\n\nFROM snapshot_source", "relation_name": "E2E_DB.RAW_ANALYTICS.dim_customers", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2025-11-24T15:30:38.947168Z", "completed_at": "2025-11-24T15:30:38.951714Z"}, {"name": "execute", "started_at": "2025-11-24T15:30:38.952240Z", "completed_at": "2025-11-24T15:30:39.427954Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.4819028377532959, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c09ba2-3202-20f8-0011-44ea0004392a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.dbt_snowflake_trans.dim_accounts", "compiled": true, "compiled_code": "\n\nWITH snapshot_source AS (\n    SELECT * FROM E2E_DB.SNAPSHOTS.snp_accounts\n)\n\nSELECT\n    account_id,\n    customer_id,\n    account_type,\n    balance,\n    currency,\n    \n    -- Business Logic v\u1eabn gi\u1eef nguy\u00ean\n    CASE \n        WHEN balance >= 5000 THEN 'VIP'\n        WHEN balance >= 1000 THEN 'GOLD'\n        ELSE 'STANDARD'\n    END AS customer_segment,\n    \n    -- C\u1ed9t l\u1ecbch s\u1eed\n    dbt_valid_from AS valid_from,\n    dbt_valid_to   AS valid_to,\n    \n    last_updated_at,\n    current_timestamp() AS dwh_load_at\n\nFROM snapshot_source", "relation_name": "E2E_DB.RAW_ANALYTICS.dim_accounts", "batch_results": null}], "elapsed_time": 7.4368462562561035, "args": {"export_saved_queries": false, "which": "build", "send_anonymous_usage_stats": true, "show_all_deprecations": false, "exclude_resource_types": [], "invocation_command": "dbt build --full-refresh", "print": true, "require_nested_cumulative_type_params": false, "partial_parse": true, "populate_cache": true, "state_modified_compare_more_unrendered_values": false, "log_level_file": "debug", "favor_state": false, "select": [], "require_explicit_package_overrides_for_builtin_materializations": true, "validate_macro_args": false, "require_all_warnings_handled_by_warn_error